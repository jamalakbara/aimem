{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": [
      "packages/**/src/**",
      "packages/**/test/**",
      "*.ts",
      "*.json",
      "!**/dist",
      "!**/node_modules",
      "!**/__snapshots__"
    ]
  }
}
