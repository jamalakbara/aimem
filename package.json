{
  "name": "aimem-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "eval": "pnpm -s build && node scripts/eval.mjs",
    "compare-models": "pnpm -s build && node scripts/compare-models.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
